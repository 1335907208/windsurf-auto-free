{
  "name": "ide-toolkit",
  "displayName": "IDE 工具箱",
  "description": "开发环境辅助工具",
  "version": "1.0.0",
  "publisher": "dev-utils",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ide-toolkit.openPanel",
        "title": "打开账号管理器",
        "icon": "$(person)"
      },
      {
        "command": "ide-toolkit.refreshDevice",
        "title": "Refresh Device ID"
      },
      {
        "command": "ide-toolkit.patchWindsurf",
        "title": "Patch Windsurf Extension"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ide-toolkit",
          "title": "账号管理器",
          "icon": "$(person)"
        }
      ]
    },
    "views": {
      "ide-toolkit": [
        {
          "id": "ide-toolkit.welcome",
          "name": "账号管理器",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "IDE 账号管理器",
      "properties": {
        "ideToolkit.backendUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "账号管理后端 API 地址"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo done",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:zh": "node scripts/build.js zh",
    "build:en": "node scripts/build.js en",
    "package:zh": "node scripts/package.js zh ide-toolkit-zh.vsix",
    "package:en": "node scripts/package.js en ide-toolkit-en.vsix"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.26.1",
    "typescript": "^5.0.0"
  }
}
